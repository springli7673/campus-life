{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "long"
      },
      "typeId": {
        "type": "long"
      },
      "campusId": {
        "type": "long"
      },
      "name": {
        "type": "text",
        "analyzer": "ik_max_word",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "area": {
        "type": "text",
        "analyzer": "ik_max_word"
      },
      "address": {
        "type": "text",
        "analyzer": "ik_max_word"
      },
      "location": {
        "type": "geo_point"
      },
      "avgPrice": {
        "type": "long"
      },
      "sold": {
        "type": "integer"
      },
      "comments": {
        "type": "integer"
      },
      "score": {
        "type": "scaled_float",
        "scaling_factor": 100
      },
      "openHours": {
        "type": "keyword"
      },
      "updateTime": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis"
      }
    }
  }
}
